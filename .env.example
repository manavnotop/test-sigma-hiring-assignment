# LLM (pi-ai → OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHEAP=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_REASON=deepseek/deepseek-v4-flash
# Long prompt-cache retention (DeepSeek cache reads = 0.1x input price).
# Keeps the crawl agent's transcript prefix cached across turns. "long" is the
# code default; unset to fall back to pi-ai's "short".
PI_CACHE_RETENTION=long

# Neo4j (Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=blastradius
NEO4J_DATABASE=neo4j

# Target application (live app + its public repo + a PR to reason about)
APP_BASE_URL=https://demo.vercel.store
REPO_FULL_NAME=vercel/commerce
PR_NUMBER=1527

# Crawler limits
CRAWL_MAX_SCREENS=25
CRAWL_MAX_ACTIONS_PER_SCREEN=6

# GitHub token (optional; unauthenticated API works for public repos but is rate-limited)
GITHUB_TOKEN=
